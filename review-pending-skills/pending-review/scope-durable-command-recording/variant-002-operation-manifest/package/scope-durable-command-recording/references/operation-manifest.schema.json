{
  "$id": "skill://scope-durable-command-recording/operation-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argv": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expected_conditions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {}
        },
        "required": [
          "condition",
          "expected"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "inputs": {
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "type": "array",
      "uniqueItems": true
    },
    "outputs": {
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "report_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "parse_json": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "cwd",
    "argv",
    "inputs",
    "outputs",
    "expected_conditions",
    "timeout_seconds",
    "purpose",
    "report_path"
  ],
  "title": "Task-required command operation manifest",
  "type": "object"
}
