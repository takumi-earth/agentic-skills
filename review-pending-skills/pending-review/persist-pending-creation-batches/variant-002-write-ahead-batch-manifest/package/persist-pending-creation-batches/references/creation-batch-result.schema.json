{
  "$id": "skill://persist-pending-creation-batches/creation-batch-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_roots": {
      "items": {
        "pattern": "^review-pending-skills/pending-review/[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "commit_oid": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "precommit_oid": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "manifest_sha256",
    "precommit_oid",
    "commit_oid",
    "candidate_roots"
  ],
  "title": "Pending skill creation batch result",
  "type": "object"
}
