{
  "$id": "skill://persist-pending-creation-batches/creation-batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_roots": {
      "items": {
        "pattern": "^review-pending-skills/pending-review/[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inventory": {
      "$ref": "#/$defs/evidenceFile"
    },
    "precommit_oid": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 2
    },
    "tree_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^review-pending-skills/pending-review/[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": "object"
    },
    "validation_reports": {
      "items": {
        "$ref": "#/$defs/evidenceFile"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "inventory",
    "candidate_roots",
    "tree_hashes",
    "validation_reports",
    "precommit_oid"
  ],
  "title": "Pending skill creation batch",
  "type": "object",
  "$defs": {
    "evidenceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  }
}
