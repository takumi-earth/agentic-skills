  "additionalProperties": true,
  "properties": {
    "artifact_class": {
      "enum": [
        "evidence-instance",
        "reusable-resource"
      ]
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "storage_owner": {
      "enum": [
        "scratchpad",
        "pending-variant"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "status"
  ],
  "title": "Owner-partitioned automatic skill evidence record",
  "type": "object"
