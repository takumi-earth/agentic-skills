{
  "$id": "skill://render-hook-decision-failures/typed-decision-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_count": {
      "minimum": 0,
      "type": "integer"
    },
    "condition": {
      "minLength": 1,
      "type": "string"
    },
    "artifact": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "approach": {
      "minLength": 1,
      "type": "string"
    },
    "expected": {},
    "received": {},
    "stage": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure"
      ]
    }
  },
  "required": [
    "status",
    "stage",
    "code",
    "condition",
    "expected",
    "received",
    "candidate_count",
    "artifact"
  ],
  "title": "Typed hook decision result",
  "type": "object"
}
