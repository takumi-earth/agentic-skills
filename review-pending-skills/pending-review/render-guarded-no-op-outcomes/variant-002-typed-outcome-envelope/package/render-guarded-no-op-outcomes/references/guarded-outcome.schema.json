{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "desired_state": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string",
          "pattern": "\\S"
        },
        "proven": {
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "proven"
      ],
      "type": "object"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "guard": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "type": "string",
          "pattern": "\\S"
        },
        "expected": {
          "type": "string"
        },
        "matched": {
          "type": "boolean"
        },
        "received": {
          "type": "string"
        }
      },
      "required": [
        "condition",
        "expected",
        "received",
        "matched"
      ],
      "type": "object"
    },
    "operation": {
      "minLength": 1,
      "type": "string",
      "pattern": "\\S"
    },
    "outcome": {
      "enum": [
        "write",
        "no-op",
        "blocked",
        "failed",
        "verified"
      ]
    },
    "target": {
      "minLength": 1,
      "type": "string",
      "pattern": "\\S"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not-run",
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "status",
        "description"
      ],
      "type": "object"
    },
    "write_count": {
      "minimum": 0,
      "type": "integer"
    },
    "application_outcome": {
      "enum": [
        "write",
        "no-op",
        "blocked",
        "failed"
      ]
    }
  },
  "required": [
    "operation",
    "target",
    "outcome",
    "guard",
    "desired_state",
    "write_count",
    "verification",
    "error"
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "application_outcome"
        ],
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "application_outcome"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "description": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "outcome": {
                "const": "no-op"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "const": "verified"
              },
              "application_outcome": {
                "const": "no-op"
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "guard": {
            "properties": {
              "matched": {
                "const": true
              }
            }
          },
          "desired_state": {
            "properties": {
              "proven": {
                "const": true
              }
            }
          },
          "write_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "outcome": {
                "const": "blocked"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "const": "verified"
              },
              "application_outcome": {
                "const": "blocked"
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "guard": {
            "properties": {
              "matched": {
                "const": false
              }
            }
          },
          "write_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "outcome": {
                "const": "write"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "const": "verified"
              },
              "application_outcome": {
                "const": "write"
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "guard": {
            "properties": {
              "matched": {
                "const": true
              }
            }
          },
          "write_count": {
            "exclusiveMinimum": 0
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "const": "verified"
              },
              "application_outcome": {
                "const": "failed"
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
