{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "goal_id": {
            "minLength": 1,
            "type": "string"
          },
          "observed_at": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "blocked",
              "complete"
            ]
          }
        },
        "required": [
          "goal_id",
          "status",
          "observed_at"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "records"
  ],
  "type": "object"
}
