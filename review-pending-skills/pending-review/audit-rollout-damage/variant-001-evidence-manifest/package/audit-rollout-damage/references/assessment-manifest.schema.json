{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/audit-rollout-damage/assessment-manifest.schema.json",
  "title": "Rollout damage assessment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report",
    "evidence_inputs",
    "qualification_levels"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceInput"
      }
    },
    "qualification_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/qualificationLevel"
      }
    },
    "report": {
      "$ref": "#/$defs/report"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "format", "role"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "path": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "enum": ["json", "jsonl"]
        },
        "role": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "locator"],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "path"],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "where": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/predicate"
          }
        }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": ["string", "number", "boolean", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "eq": {},
            "in": {
              "type": "array",
              "minItems": 1
            },
            "gte": {
              "type": "number"
            },
            "lte": {
              "type": "number"
            }
          }
        }
      ]
    },
    "verbatimSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select", "extract_path"],
      "properties": {
        "select": {
          "$ref": "#/$defs/selector"
        },
        "extract_path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "dependentRequired": {
        "start_line": ["line_count"],
        "line_count": ["start_line"]
      }
    },
    "collectionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select", "extract_each_path", "label_fields"],
      "properties": {
        "select": {
          "$ref": "#/$defs/selector"
        },
        "extract_each_path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "label_fields": {
          "$ref": "#/$defs/nonemptyStrings"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select", "operation"],
      "properties": {
        "select": {
          "$ref": "#/$defs/selector"
        },
        "operation": {
          "enum": ["sum_fields", "field", "count_changed_lines", "count_records"]
        },
        "fields": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "field": {
          "$ref": "#/$defs/nonemptyString"
        },
        "prefixes": {
          "$ref": "#/$defs/nonemptyStrings"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity",
        "description",
        "landed_state",
        "candidate_state",
        "evidence_refs",
        "measurement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "identity": {
          "$ref": "#/$defs/nonemptyString"
        },
        "description": {
          "$ref": "#/$defs/nonemptyString"
        },
        "landed_state": {
          "$ref": "#/$defs/nonemptyString"
        },
        "candidate_state": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "citedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs"],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "citedStatements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/citedStatement"
      }
    },
    "decisionDossier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "verbatim_exhibits",
        "summary",
        "prior_state",
        "change",
        "trace_context",
        "stated_rationale",
        "authority_assessment",
        "behavioral_effects",
        "causal_dependencies",
        "keep_consequences",
        "reverse_consequences",
        "recommended_disposition",
        "confidence",
        "unknowns"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "verbatim_exhibits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verbatimExhibit"
          }
        },
        "summary": {
          "$ref": "#/$defs/citedStatement"
        },
        "prior_state": {
          "$ref": "#/$defs/citedStatement"
        },
        "change": {
          "$ref": "#/$defs/citedStatement"
        },
        "trace_context": {
          "$ref": "#/$defs/citedStatements"
        },
        "stated_rationale": {
          "$ref": "#/$defs/citedStatement"
        },
        "authority_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "assessment"],
          "properties": {
            "status": {
              "enum": ["explicitly_authorized", "unauthorized", "mixed_authority", "indeterminate"]
            },
            "assessment": {
              "$ref": "#/$defs/citedStatement"
            }
          }
        },
        "behavioral_effects": {
          "$ref": "#/$defs/citedStatements"
        },
        "causal_dependencies": {
          "$ref": "#/$defs/citedStatements"
        },
        "keep_consequences": {
          "$ref": "#/$defs/citedStatements"
        },
        "reverse_consequences": {
          "$ref": "#/$defs/citedStatements"
        },
        "recommended_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "reasons", "risks"],
          "properties": {
            "action": {
              "$ref": "#/$defs/citedStatement"
            },
            "reasons": {
              "$ref": "#/$defs/citedStatements"
            },
            "risks": {
              "$ref": "#/$defs/citedStatements"
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "basis"],
          "properties": {
            "level": {
              "enum": ["high", "medium", "low"]
            },
            "basis": {
              "$ref": "#/$defs/citedStatement"
            }
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "verbatimExhibit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "scope",
        "effect_state",
        "source",
        "interpretation",
        "evidence_refs"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+.-]+$"
        },
        "scope": {
          "enum": ["complete_change", "selected_excerpt"]
        },
        "effect_state": {
          "enum": ["landed", "attempted_not_landed", "prior_state"]
        },
        "source": {
          "$ref": "#/$defs/verbatimSource"
        },
        "interpretation": {
          "$ref": "#/$defs/citedStatement"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "omitted": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "qualificationLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "definition", "metric", "automatic_action", "records", "representative_assessments"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "definition": {
          "$ref": "#/$defs/nonemptyString"
        },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "unit", "caveat"],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonemptyString"
            },
            "unit": {
              "$ref": "#/$defs/nonemptyString"
            },
            "caveat": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        "automatic_action": {
          "$ref": "#/$defs/nonemptyString"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "representative_assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionDossier"
          }
        }
      }
    },
    "terminology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition", "not_equivalent_to", "examples"],
      "properties": {
        "term": {
          "$ref": "#/$defs/nonemptyString"
        },
        "definition": {
          "$ref": "#/$defs/nonemptyString"
        },
        "not_equivalent_to": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "examples": {
          "$ref": "#/$defs/nonemptyStrings"
        }
      }
    },
    "qualitativeExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "description", "evidence_refs"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nonemptyString"
        },
        "description": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "qualitativeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "impacts", "examples"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "summary": {
          "$ref": "#/$defs/nonemptyString"
        },
        "impacts": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/qualitativeExample"
          }
        }
      }
    },
    "evidenceCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "effect_state", "description", "source", "evidence_refs"],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+.-]+$"
        },
        "effect_state": {
          "enum": ["landed", "attempted_not_landed", "unresolved"]
        },
        "description": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source": {
          "$ref": "#/$defs/collectionSource"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "decisionEvidenceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "artifacts", "what_changed", "why_it_matters", "evidence_refs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "artifacts": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "what_changed": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "why_it_matters": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "decisionEvidencePacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "changes", "trace_appendix", "evidence_refs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "summary": {
          "$ref": "#/$defs/nonemptyString"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionEvidenceChange"
          }
        },
        "trace_appendix": {
          "$ref": "#/$defs/evidenceCollection"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "remediationOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "title", "summary", "actions", "decision_units", "reasons", "risks"],
      "properties": {
        "role": {
          "enum": ["aggressive", "conservative", "recommended"]
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "summary": {
          "$ref": "#/$defs/nonemptyString"
        },
        "actions": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "decision_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/remediationUnit"
          }
        },
        "reasons": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "risks": {
          "$ref": "#/$defs/nonemptyStrings"
        }
      }
    },
    "remediationUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "artifacts",
        "evidence_packet",
        "retain",
        "remove_or_restore",
        "requires_decision",
        "approved_means",
        "rejected_means",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "artifacts": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "evidence_packet": {
          "$ref": "#/$defs/nonemptyString"
        },
        "retain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "remove_or_restore": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "requires_decision": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "approved_means": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "rejected_means": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "reason": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "scope",
        "conclusion",
        "authority",
        "headline_facts",
        "terminology",
        "measurement_notes",
        "qualitative_changes",
        "decision_evidence_packets",
        "remediation_options",
        "recommendation",
        "limits"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scope": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "conclusion": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "authority": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "headline_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "unit", "description", "evidence_refs", "measurement"],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonemptyString"
              },
              "label": {
                "$ref": "#/$defs/nonemptyString"
              },
              "unit": {
                "$ref": "#/$defs/nonemptyString"
              },
              "description": {
                "$ref": "#/$defs/nonemptyString"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/evidenceReference"
                }
              },
              "measurement": {
                "$ref": "#/$defs/measurement"
              }
            }
          }
        },
        "terminology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/terminology"
          }
        },
        "measurement_notes": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "qualitative_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/qualitativeChange"
          }
        },
        "decision_evidence_packets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionEvidencePacket"
          }
        },
        "remediation_options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/remediationOption"
          }
        },
        "recommendation": {
          "enum": ["aggressive", "conservative", "recommended"]
        },
        "limits": {
          "$ref": "#/$defs/nonemptyStrings"
        }
      }
    }
  }
}
